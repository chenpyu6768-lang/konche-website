# Cloudflare Pages security headers.
# (GitHub Pages ignores this file; it takes effect after the site moves to Pages.)
# CSP allowlists mirror the in-page meta CSP (Google Translate runtime needs them)
# minus its blanket script https:, plus Cloudflare Turnstile and the form Worker.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://translate.google.com https://translate.gstatic.com https://www.gstatic.com https://fonts.gstatic.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://translate.googleapis.com https://www.gstatic.com https://challenges.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://translate.google.com https://translate.googleapis.com https://www.gstatic.com https://challenges.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://www.gstatic.com; connect-src 'self' https://konche-form.chenpyu6768.workers.dev https://translate-pa.googleapis.com https://translate.googleapis.com https://translate.google.com https://challenges.cloudflare.com; frame-src https://translate.google.com https://translate.googleapis.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:

# Assets can be cached for a day (filenames carry ?v= cache-busting on change).
/app/*
  Cache-Control: public, max-age=86400
